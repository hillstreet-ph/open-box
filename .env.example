# Open-Box / OpenList runtime (Zeabur; no OPENLIST_ prefix — image uses --no-prefix)
PORT=5244
SITE_URL=https://open-box.space
PUBLIC_DOMAIN=open-box.space
TZ=Asia/Manila
UMASK=022

# Website admin login (username is always admin)
ADMIN_PASSWORD=
OPENLIST_ADMIN_PASSWORD=

DB_TYPE=postgres
# Required secret: use the verified open-platform session-pooler DSN.
# Include sslmode=require and search_path=open_box; never use the default public schema.
# Obtain the exact host, role, and password from the provider secret store.
# Do not start the application until DB_DSN is populated and schema/restore checks pass.
DB_DSN=
DB_TABLE_PREFIX=x_

# Optional S3-compatible master storage (R2 or Supabase S3).
# Keep credentials in the runtime secret manager, never Git.
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=open-box-files

# Supabase Auth is used by the optional Cloudflare front-door gateway only.
# It does not replace OpenList/Open-Box JWT accounts in x_users.
SUPABASE_URL=https://huadtiuuoiriqrjpjxhr.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
